<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only the feeds named here, whatever the machine has configured. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Every package has one feed it may come from. Add a pattern for each private feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
